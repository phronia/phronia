{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .trae/hooks/phronia-hook.py --event session-start --platform trae",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "RunCommand|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .trae/hooks/phronia-hook.py --event pre-shell --platform trae",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .trae/hooks/phronia-hook.py --event user-prompt --platform trae",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
