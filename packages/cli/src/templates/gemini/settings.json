{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .gemini/hooks/phronia-hook.py --event session-start --platform gemini",
            "timeout": 30000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .gemini/hooks/phronia-hook.py --event user-prompt --platform gemini",
            "timeout": 15000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "run_shell_command|ShellTool",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .gemini/hooks/phronia-hook.py --event pre-shell --platform gemini",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
