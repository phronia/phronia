{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .codebuddy/hooks/phronia-hook.py --event session-start --platform codebuddy",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .codebuddy/hooks/phronia-hook.py --event session-start --platform codebuddy",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .codebuddy/hooks/phronia-hook.py --event session-start --platform codebuddy",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "task|Task",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .codebuddy/hooks/phronia-hook.py --event subagent-spawn --platform codebuddy",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "execute_command|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .codebuddy/hooks/phronia-hook.py --event pre-shell --platform codebuddy",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .codebuddy/hooks/phronia-hook.py --event user-prompt --platform codebuddy",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
