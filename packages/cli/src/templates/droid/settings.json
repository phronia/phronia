{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .factory/hooks/phronia-hook.py --event session-start --platform droid",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .factory/hooks/phronia-hook.py --event session-start --platform droid",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .factory/hooks/phronia-hook.py --event session-start --platform droid",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .factory/hooks/phronia-hook.py --event subagent-spawn --platform droid",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Execute|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .factory/hooks/phronia-hook.py --event pre-shell --platform droid",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .factory/hooks/phronia-hook.py --event user-prompt --platform droid",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
